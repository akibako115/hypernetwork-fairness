# Experiment packages
# 仮説パッケージ（experiments/<slug>/）の重い実体は追跡しない。
# 成果物パッケージは README / runs.md / reports / figures / results を追跡する。
# 構成と追跡境界の説明は experiments/README.md を参照する。
/experiments/**/checkpoints/
/experiments/**/outputs/
/experiments/**/cache/
/experiments/**/*.npz
/experiments/**/*.pt
/experiments/**/*.pth
# 上の *.png 一括除外を、レポートが参照する採用図だけ打ち消す。
!/experiments/*/figures/**/*.png

# Aim logging
.aim

# uv
# uv.lock は追跡する。学習結果を比較するために依存バージョンを固定する必要があり、
# dockerfile も `uv sync --frozen` でこのファイルを使う。
/projects/*/configs/weights/computed.yaml

# .claude
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/hooks/

# Experiment runtime
/.run-preview/
/projects/**/__pycache__/

# Checked-in direnv settings contain only the bytecode cache location.
!.envrc
